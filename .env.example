# Local development only. Change both values together if changing the password.
POSTGRES_PASSWORD=spindle-local-only
DATABASE_URL=postgresql://spindle:spindle-local-only@127.0.0.1:15432/spindle
HOST=127.0.0.1
PORT=3000
# Vite frontend bind address; API HOST is independent. For a remote LAN proxy,
# set WEB_HOST to this machine's LAN IP (or 0.0.0.0) and use an HTTPS APP_URL.
WEB_HOST=127.0.0.1

# Public browser origin. HTTPS is required outside explicit loopback development.
APP_URL=http://127.0.0.1:5173
ALLOW_INSECURE_LOCALHOST=true
# Generate a secret with: openssl rand -base64 48
AUTH_SECRET=
REGISTRATION_MODE=invite
# Optional comma-separated IPs/CIDRs of trusted reverse proxies. Unset means none.
# TRUST_PROXY=127.0.0.1/32
# See docs/network-access.md for same-machine/remote reverse-proxy setup.

# Mailpit captures development emails at http://127.0.0.1:8025
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
MAIL_FROM=noreply@spindle.test
# SMTP_USER and SMTP_PASSWORD must be supplied together for an authenticated relay.

# Resend: replace the Mailpit values above after verifying the sending domain.
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=resend
# SMTP_PASSWORD=<Resend sending key; never commit a real key>
# MAIL_FROM=noreply@spindle.staplett.xyz
# See docs/resend.md. Keep APP_URL matching the actual browser origin.

# Separate encryption for connected mailbox credentials. Required for mail connection.
# Generate a 32-byte base64 key ring using the command in docs/imap.md.
MAIL_ENCRYPTION_KEY_ID=v1
MAIL_ENCRYPTION_KEYS=

# The API starts an isolated HTML/image listener alongside the app API.
# Loopback development automatically chooses a different hostname on port 3001.
CONTENT_HOST=127.0.0.1
CONTENT_PORT=3001
# Hosted HTML requires a distinct hostname with HTTPS, proxied to the listener above.
# CONTENT_URL=https://mail-content.example.com

# Private ClamAV endpoint used by the worker for outgoing attachment scans.
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
